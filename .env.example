# Media Stack configuration example.
# Copy this file to .env and replace each placeholder with the values for your deployment.
# The real .env file is ignored by Git and should never be committed.

# Internal Docker networking
RADARR_STATIC_CONTAINER_IP=172.20.0.50
SONARR_STATIC_CONTAINER_IP=172.20.0.51
SABNZBD_STATIC_CONTAINER_IP=172.20.0.52
LIDARR_STATIC_CONTAINER_IP=172.20.0.53
PROWLARR_STATIC_CONTAINER_IP=172.20.0.54
MULTI_SCROBBLER_STATIC_CONTAINER_IP=172.20.0.55

# Profile used by the VPN-backed download services
COMPOSE_PROFILES=vpn

# VPN / Gluetun secrets
# WIREGUARD_PRIVATE_KEY is the WireGuard private key from your VPN provider config.
# GLUETUN_API_KEY is the Gluetun control API key.
WIREGUARD_PRIVATE_KEY=replace-with-wireguard-private-key
GLUETUN_API_KEY=replace-with-gluetun-api-key

# Plex auth
# PLEX_CLAIM is used when registering the Plex server for the first time.
# PLEX_TOKEN is the Plex application token used by Multi-Scrobbler.
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxx
PLEX_TOKEN=replace-with-plex-token

# ListenBrainz values used by Multi-Scrobbler
# LZ_TOKEN is the ListenBrainz token; LZ_USER is the account username.
LZ_TOKEN=00000000-0000-0000-0000-000000000000
LZ_USER=your-listenbrainz-username

# slskd credentials used by the VPN service and related integrations
SLSKD_SLSK_USERNAME=your-slskd-username
SLSKD_SLSK_PASSWORD=replace-with-slskd-password
SLSKD_API_KEY=replace-with-slskd-api-key

# ARR API keys used by unpackerr and decluttarr
SONARR_0_API_KEY=replace-with-sonarr-api-key
RADARR_0_API_KEY=replace-with-radarr-api-key
LIDARR_0_API_KEY=replace-with-lidarr-api-key
SABNZBD_API_KEY=replace-with-sabnzbd-api-key

# qBittorrent UI credentials used behind the VPN service
QBIT_USERNAME=admin
QBIT_PASSWORD=replace-with-qbittorrent-password

# Optional credentials for services that are not always enabled
GEMINI_API_KEY=replace-with-gemini-key-if-used

# Notifiarr API key (36 characters). Leave blank here and copy into .env
NOTIFIARR_API_KEY=replace-with-36-char-notifiarr-api-key
# Notifiarr will generate this each time you don't provide one. Get it from the Notifiarr dashboard and paste it here to keep your host ID consistent across deployments.
NOTIFIARR_HOST_ID=replace-with-notifiarr-host-id