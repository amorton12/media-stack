# Fresh repo hygiene: never track local runtime state or secrets.
.git/
.gitmodules
*.orig
*.rej
*.bak
*.swp
*.tmp

# Environment files and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/.env.local

# Common runtime data and local state that should not be backed up
**/logs/
**/cache/
**/downloads/
**/incomplete/
**/metadata/
**/state/
**/tmp/
**/data/
**/transcode/
**/auth/
**/servers/
**/vpn/
**/.cache/
**/MediaCover/
**/Backups/
**/GeoDB/
**/BT_backup/
**/rss/
**/Sentry/
**/.installation
**/.session
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log
**/*.pid
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.ovpn
**/*.local
**/*.override.*
**/*.secret
**/*secret*
**/*token*

# Service-specific local files and large runtime artifacts that must never be committed
maintainerr/*.sqlite
maintainerr/logs/
maintainerr/github-cache.json
multi-scrobbler/*.db*
multi-scrobbler/logs/
qbittorrent/.ash_history
qbittorrent/qBittorrent/
qbittorrent/qBittorrent/*.conf
qbittorrent/qBittorrent/*.json
qbittorrent/qBittorrent/lockfile
qbittorrent/qBittorrent/logs/
qbittorrent/qBittorrent/rss/
qbittorrent/qBittorrent/BT_backup/
qbittorrent/qBittorrent/GeoDB/
slskd/slskd.yml
slskd/slskd.yml.bak
slskd/downloads/
slskd/incomplete/
slskd/data/
sabnzbd/Downloads/
sabnzbd/logs/
sabnzbd/admin/*.sab
seerr/db/
seerr/logs/
prowlarr/logs/
prowlarr/Backups/
prowlarr/Definitions/
prowlarr/*.pid
jellyfin/cache/
jellyfin/config/log/
radarr/MediaCover/
radarr/*.pid
sonarr/MediaCover/
sonarr/*.pid
lidarr/MediaCover/
lidarr/Sentry/
notifiarr/
NOTIFIARR.md
soularr/config.ini
soularr/config.ini.bak
explo/.env
explo/.env.local

# Keep checked-in example templates only
!**/*.example
!explo/.env.example
!slskd/slskd.yml.example
!soularr/config.ini.example

# MediaSage runtime data and credentials
mediasage/
mediasage/**
